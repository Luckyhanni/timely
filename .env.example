# Set these in the hosting dashboard or load the file with Node's --env-file option.
# Without DATABASE_URL the app serves only the public browser demonstration.
DATABASE_URL=
NODE_ENV=production
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000
APP_URL=https://blank-timely.de
# Exact number of trusted reverse proxies. Set only after verifying the hosting setup.
# TRUST_PROXY=1
# Only for an empty database: set an individual PIN (4–6 digits) and remove after bootstrap.
# INITIAL_ADMIN_NAME=Admin
# INITIAL_ADMIN_PIN=
