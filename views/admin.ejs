<% layout('layout',{user}) %>
<div class="max-w-screen-2xl mx-auto space-y-6">
  <div class="flex flex-wrap justify-between items-end gap-4">
    <div><div class="text-sm text-white/50">Verwaltung</div><h1 class="text-2xl md:text-3xl font-bold">Team & Wochenübersicht</h1></div>
    <form method="get" class="timely-form flex flex-wrap items-end gap-2">
      <label>Woche wählen<input type="date" name="week" value="<%= week %>" required></label>
      <button class="btn-vintage px-4 py-2 rounded">Anzeigen</button>
    </form>
  </div>
  <div class="grid sm:grid-cols-3 gap-3">
    <div class="card p-4"><div class="text-white/60 text-sm">Abgeschlossene Arbeitszeit</div><div class="text-2xl font-bold mt-2"><%= duration(rows.reduce((sum,r)=>sum+r.minutes,0)) %></div><div class="text-xs text-white/50">Netto · ausgewählte Woche</div></div>
    <div class="card p-4"><div class="text-white/60 text-sm">Krankheitstage</div><div class="text-2xl font-bold mt-2"><%= rows.reduce((sum,r)=>sum+r.sick,0) %></div><div class="text-xs text-white/50">Nur erfasste Krankheit an geplanten Arbeitstagen</div></div>
    <div class="card p-4"><div class="text-white/60 text-sm">Offene Buchungen insgesamt</div><div class="text-2xl font-bold mt-2 status-open"><%= open.length %></div><a class="text-xs underline" href="#offene-buchungen">Prüfen und korrigieren</a></div>
  </div>
  <section class="card p-4 md:p-6">
    <div class="flex flex-wrap justify-between gap-3 mb-4">
      <h2 class="font-semibold"><%= weekTitle %> · <%= dayjs(week).format('DD.MM.') %> bis <%= dayjs(to).format('DD.MM.YYYY') %></h2>
      <div class="flex gap-4 text-sm"><a class="underline" href="?week=<%= previous %>">← Vorige</a><a class="underline" href="/admin">Diese Woche</a><a class="underline" href="?week=<%= next %>">Nächste →</a></div>
    </div>
    <div class="overflow-x-auto">
      <table class="week-table">
        <thead><tr><th>Mitarbeiter</th><% days.forEach((date,i)=>{ %><th><%= ['Mo','Di','Mi','Do','Fr','Sa','So'][i] %><br><%= dayjs(date).format('DD.MM.') %></th><% }) %><th>Woche</th><th>Krank<br>Woche / <%= year %></th></tr></thead>
        <tbody>
          <% rows.forEach(row=>{ %><tr>
            <td><strong><%= row.employee.name %></strong><div class="text-white/50 text-xs mt-1"><%= profiles[row.employee.schedule_profile] %></div><% if(!row.employee.active){ %><span class="status-pill">Inaktiv</span><% } %></td>
            <% row.cells.forEach(cell=>{ %><td>
              <a class="day-link" href="/admin/entries/edit?employee_id=<%= row.employee.id %>&date=<%= cell.date %>" aria-label="Zeit von <%= row.employee.name %> am <%= cell.date %> bearbeiten">
                <% if(cell.status) { %><span class="status-pill <%= cell.status.status==='sick'?'status-sick':'' %>"><%= statusLabels[cell.status.status] %><%= cell.sick?' · zählt':'' %></span><% } %>
                <% if(cell.entries.some(e=>e.check_out)) { %><strong class="block"><%= duration(cell.closedMinutes) %></strong><% } %>
                <% if(cell.open) { %><div class="status-open">Offen · prüfen</div><% } %>
                <% if(!cell.status && !cell.entries.some(e=>e.check_in)) { %><span class="text-white/50"><%= ({work:'—',off:'Frei',school:'Berufsschule',flexible:'Flexibel',unassigned:'Plan fehlt',calendar_missing:'Ferien prüfen'})[cell.planned] %></span><% } %>
              </a>
              <% cell.entries.filter(e=>e.check_in).forEach(entry=>{ %><a class="block text-xs text-white/60 underline mt-1" href="/admin/entries/edit?employee_id=<%= row.employee.id %>&date=<%= cell.date %>&id=<%= entry.id %>"><%= dayjs(entry.check_in).tz(TZ).format('HH:mm') %> – <%= entry.check_out?dayjs(entry.check_out).tz(TZ).format('HH:mm'):'offen' %></a><% }) %>
            </td><% }) %>
            <td class="font-bold"><%= duration(row.minutes) %></td><td><%= row.employee.schedule_profile==='casual'?'—':row.sick+' / '+row.yearSick %></td>
          </tr><% }) %>
          <% if(!rows.length) { %><tr><td colspan="10">Noch keine Mitarbeiter angelegt.</td></tr><% } %>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-white/50 mt-4">Tag anklicken, um Zeiten zu ergänzen oder zu korrigieren. Offene Buchungen zählen erst nach dem Abschluss zur Summe. Fehlende Buchungen sind keine Krankheitstage. Berufsschulstunden werden nicht pauschal als Arbeitsstunden gutgeschrieben.</p>
  </section>
  <section class="card p-6" id="offene-buchungen">
    <h2 class="font-semibold mb-3">Offene Buchungen</h2>
    <% if(open.length) { %><a class="inline-block underline text-sm mb-4" href="/admin/entries/close-open">Altbuchungen pauschal ergänzen · Vorschau öffnen</a><% } %>
    <% if(!open.length) { %><p class="text-white/60 text-sm">Alle begonnenen Arbeitstage sind abgeschlossen.</p><% } %>
    <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-3"><% open.forEach(entry=>{ %>
      <a class="border border-amber-200/20 rounded p-3 hover:bg-white/5" href="/admin/entries/edit?employee_id=<%= entry.employee_id %>&date=<%= entry.date %>&id=<%= entry.id %>">
        <strong><%= entry.name %></strong><div class="text-sm text-white/60"><%= dayjs(entry.date).format('DD.MM.YYYY') %> · seit <%= dayjs(entry.check_in).tz(TZ).format('HH:mm') %></div><div class="text-sm status-open mt-1"><%= entry.date<new Date().toLocaleDateString('en-CA',{timeZone:TZ})?'Check-out fehlt · korrigieren':'Heute eingecheckt · bearbeiten' %> →</div>
      </a>
    <% }) %></div>
  </section>
  <div class="grid xl:grid-cols-2 gap-6">
    <section class="card p-6">
      <h2 class="font-semibold mb-4">Krankheit, Urlaub & Tagesplan</h2>
      <form action="/admin/days/save" method="post" class="timely-form space-y-3">
        <%- include('_csrf') %><input name="week" type="hidden" value="<%= week %>">
        <label>Mitarbeiter<select name="employee_id" required><% employees.forEach(e=>{ %><option value="<%= e.id %>"><%= e.name %></option><% }) %></select></label>
        <div class="grid sm:grid-cols-2 gap-3"><label>Von<input name="from" type="date" value="<%= week %>" required></label><label>Bis<input name="to" type="date" value="<%= to %>" required></label></div>
        <label>Status<select name="status"><% Object.entries(statusLabels).forEach(([key,label])=>{ %><option value="<%= key %>"><%= label %></option><% }) %><option value="clear">Eintrag entfernen · regulären Plan verwenden</option></select></label>
        <label>Abweichender Arbeitsplan für diesen Zeitraum<select name="planned_override"><option value="">Regulären Arbeitsplan verwenden</option><option value="work">Arbeitstage (z. B. Schule fällt aus)</option><option value="school">Berufsschule</option><option value="off">Frei / Feiertag</option></select></label>
        <label>Grund<textarea name="reason" required minlength="3" maxlength="500" placeholder="Zum Beispiel: Krankmeldung vom Mitarbeiter erhalten."></textarea></label>
        <p class="text-xs text-white/60">Sebastian, Andi und David: Mo–Fr. Babette: Di–Sa. Theo: Mo–Fr, mittwochs Berufsschule außer in den Ferien. Aushilfen: keine Krankheitstage. Schulferien sind bis Sommer 2030 hinterlegt; schulische Abweichungen und arbeitsfreie Feiertage hier ausdrücklich eintragen. Eine Krankmeldung wird gespeichert, an freien oder Schultagen aber nicht als Krankheitstag gezählt.</p>
        <button class="btn-vintage rounded px-4 py-2">Status speichern</button>
      </form>
    </section>
    <section class="card p-6">
      <h2 class="font-semibold mb-4">Excel-Export</h2>
      <form method="get" action="/admin/export" class="timely-form space-y-3">
        <div class="grid sm:grid-cols-2 gap-3"><label>Von<input type="date" name="from" value="<%= week %>" required></label><label>Bis<input type="date" name="to" value="<%= to %>" required></label></div>
        <p class="text-sm text-white/60">Arbeitszeiten, Tagesstatus und Wochensummen als Excel-Datei. Offene Buchungen sind gekennzeichnet. Der Export verändert keine erfassten Zeiten oder Pausen.</p>
        <button class="btn-vintage rounded px-4 py-2">Excel herunterladen</button>
      </form>
    </section>
  </div>
  <section class="card p-6">
    <h2 class="font-semibold mb-4">Mitarbeiter & Arbeitspläne</h2>
    <div class="grid lg:grid-cols-2 gap-3"><% employees.forEach(employee=>{ %>
      <details class="border border-white/10 rounded p-3"><summary><strong><%= employee.name %></strong> · <%= employee.is_admin?'Admin':'Mitarbeiter' %><%= employee.active?'':' · Inaktiv' %><div class="text-xs text-white/50 mt-1"><%= profiles[employee.schedule_profile] %></div></summary>
        <form method="post" action="/admin/employees/update" class="timely-form mt-4 space-y-3">
          <%- include('_csrf') %><input type="hidden" name="id" value="<%= employee.id %>"><input type="hidden" name="week" value="<%= week %>">
          <label>Name<input name="name" value="<%= employee.name %>" required maxlength="100"></label>
          <label>Neue PIN · leer lassen zum Beibehalten<input name="pin" type="password" inputmode="numeric" pattern="[0-9]{4,6}" minlength="4" maxlength="6" autocomplete="new-password"></label>
          <label>Arbeitsplan<select name="schedule_profile"><% Object.entries(profiles).forEach(([key,label])=>{ %><option value="<%= key %>" <%= employee.schedule_profile===key?'selected':'' %>><%= label %></option><% }) %></select></label>
          <label><input type="checkbox" name="is_admin" <%= employee.is_admin?'checked':'' %>>Admin</label>
          <label><input type="checkbox" name="active" <%= employee.active?'checked':'' %>>Konto aktiv · bei Austritt deaktivieren, Zeiten bleiben erhalten</label>
          <label>Grund<input name="reason" required minlength="3" maxlength="500" placeholder="Zum Beispiel: Arbeitsplan festgelegt."></label>
          <button class="btn-vintage rounded px-4 py-2">Mitarbeiter speichern</button>
        </form>
      </details>
    <% }) %></div>
    <details class="mt-4 border border-white/10 rounded p-3"><summary>Mitarbeiter hinzufügen</summary>
      <form method="post" action="/admin/employees/add" class="timely-form mt-4 grid sm:grid-cols-2 gap-3">
        <%- include('_csrf') %><input type="hidden" name="week" value="<%= week %>">
        <label>Name<input name="name" required maxlength="100"></label><label>PIN (4–6 Ziffern)<input name="pin" type="password" inputmode="numeric" pattern="[0-9]{4,6}" required autocomplete="new-password"></label>
        <label>Arbeitsplan<select name="schedule_profile"><option value="">Anhand des Namens zuordnen</option><% Object.entries(profiles).forEach(([key,label])=>{ %><option value="<%= key %>"><%= label %></option><% }) %></select></label>
        <label class="self-center"><input type="checkbox" name="is_admin">Admin</label><button class="btn-vintage rounded px-4 py-2">Hinzufügen</button>
      </form>
    </details>
    <p class="text-xs text-white/50 mt-4">Arbeitspläne werden bei bestehenden Mitarbeitern einmalig anhand des Vornamens zugeordnet. Bitte Zuordnung vor der Nutzung prüfen. Planänderungen gelten auch für die Auswertung bereits gespeicherter Krankmeldungen.</p>
  </section>
  <section class="card p-6">
    <h2 class="font-semibold mb-4">Vor Ort per QR-Code buchen <span class="status-pill"><%= onsiteConfig.enabled?'Aktiv':'Noch nicht aktiviert' %></span></h2>
    <div class="grid lg:grid-cols-2 gap-6">
      <form method="post" action="/admin/onsite" class="timely-form space-y-3">
        <%- include('_csrf') %><input type="hidden" name="week" value="<%= week %>">
        <p class="text-sm text-white/60">Mitarbeiter verbinden sich mit dem Betriebs-WLAN und scannen den Ausdruck. Beim ersten Mal geben sie Name und PIN ein und verknüpfen ihr persönliches Handy. Weitere Scans öffnen direkt das zugeordnete Konto. Jede Buchung muss innerhalb von 2 Minuten bestätigt werden. Der Server prüft weiterhin den Betriebsanschluss, auch bei Pausen. Die Verwaltung erfordert weiterhin eine PIN.</p>
        <p class="text-sm">Dein aktuell erkannter Anschluss: <strong><%= ip %></strong><br><span class="text-white/50 text-xs">Nur übernehmen, wenn du gerade im Betriebs-WLAN bist.</span></p>
        <label>Erlaubte öffentliche IP-Adressen / Netze des Betriebs<textarea name="networks" rows="3" placeholder="Eine Adresse je Zeile"><%= onsiteConfig.networks %></textarea></label>
        <% if(!qrUrl) { %><p class="text-sm status-open">Vor der Aktivierung muss die öffentliche App-Adresse am Server als APP_URL eingerichtet werden. Bei einem vorgeschalteten Hosting-Proxy muss außerdem die Erkennung der Anschlussadresse stimmen.</p><% } %>
        <label><input type="checkbox" name="enabled" <%= onsiteConfig.enabled?'checked':'' %>>Vor-Ort-Buchung verpflichtend aktivieren</label>
        <label><input type="checkbox" name="rotate">Neuen QR-Code erzeugen · alter Ausdruck wird ungültig</label>
        <label>Grund<input name="reason" required minlength="3" maxlength="500" placeholder="Zum Beispiel: Betriebsanschluss eingerichtet."></label>
        <button class="btn-vintage rounded px-4 py-2">Vor-Ort-Einstellung speichern</button>
      </form>
      <div>
        <% if(qrImage) { %><div class="qr-sheet bg-white text-black p-6 rounded text-center">
          <h3 class="text-2xl font-bold">Timely · Hier Zeit buchen</h3><% if(!onsiteConfig.enabled) { %><p class="font-bold mt-2">NOCH NICHT AKTIV</p><% } %>
          <img class="w-64 max-w-full mx-auto my-3" src="<%= qrImage %>" alt="QR-Code zur Vor-Ort-Buchung">
          <p>1. Mit dem Betriebs-WLAN verbinden.<br>2. QR-Code mit der Handykamera scannen.<br>3. Einmalig Name und PIN eingeben, Handy verknüpfen.<br>4. Einchecken, Auschecken oder Pause bestätigen.</p>
          <p class="text-sm mt-3">Für jede Buchung erneut scannen.</p>
        </div><a href="/admin/qr" target="_blank" rel="noopener" class="inline-block btn-vintage rounded px-4 py-2 mt-3">QR-Code drucken</a><% } %>
        <p class="text-xs text-white/50 mt-4">Ein Papiercode kann kopiert werden. Der Ortsnachweis erfolgt über den erlaubten Internetanschluss, nicht über den Ausdruck. Wechselt die öffentliche IP des Betriebs, muss sie aktualisiert werden. Ein VPN ins Betriebsnetz würde ebenfalls als vor Ort gelten.</p>
      </div>
    </div>
  </section>
  <section class="card p-6">
    <h2 class="font-semibold mb-4">Verknüpfte Mitarbeitergeräte</h2>
    <p class="text-sm text-white/60 mb-4">Bei Verlust oder Weitergabe eines Handys hier sperren. Eine neue PIN oder die Deaktivierung des Kontos sperrt alle zugehörigen Geräte und beendet bestehende Sitzungen.</p>
    <div class="grid lg:grid-cols-2 gap-3"><% devices.forEach(device=>{ %>
      <div class="border border-white/10 rounded p-4">
        <strong><%= device.name %> · <%= device.label %></strong><% if(device.id===currentDeviceId) { %><span class="text-sm text-amber-200"> · Dieses Gerät</span><% } %>
        <p class="text-xs text-white/60 mt-2">Verknüpft: <%= dayjs(device.created_at).tz(TZ).format('DD.MM.YYYY') %> · Zuletzt verwendet: <%= dayjs(device.last_used_at).tz(TZ).format('DD.MM.YYYY HH:mm') %></p>
        <form method="post" action="/admin/devices/revoke" class="timely-form mt-3 space-y-2">
          <%- include('_csrf') %><input type="hidden" name="id" value="<%= device.id %>"><input type="hidden" name="week" value="<%= week %>">
          <label>Grund<input name="reason" required minlength="3" maxlength="500" placeholder="Zum Beispiel: Handy verloren."></label>
          <button class="btn-rose rounded px-4 py-2">Gerät sperren<%= device.id===currentDeviceId?' und abmelden':'' %></button>
        </form>
      </div>
    <% }) %></div>
    <% if(!devices.length) { %><p class="text-sm text-white/50">Noch keine Geräte verknüpft.</p><% } %>
  </section>
  <section class="card p-6">
    <h2 class="font-semibold mb-4">Letzte Änderungen</h2>
    <div class="space-y-3"><% audits.forEach(a=>{ %><details class="border-b border-white/10 pb-3 text-sm"><summary><%= dayjs(a.created_at).tz(TZ).format('DD.MM.YYYY HH:mm') %> · <%= a.actor_name %> · <%= a.kind %><%= a.employee?' · '+a.employee:'' %><%= a.record_date?' · '+dayjs(a.record_date).format('DD.MM.YYYY'):'' %><div class="text-white/60 mt-1"><%= a.reason %></div></summary><div class="grid md:grid-cols-2 gap-3 mt-3"><div>Vorher<pre class="text-xs overflow-auto mt-2"><%= JSON.stringify(a.before_data,null,2) %></pre></div><div>Nachher<pre class="text-xs overflow-auto mt-2"><%= JSON.stringify(a.after_data,null,2) %></pre></div></div></details><% }) %><% if(!audits.length) { %><p class="text-sm text-white/50">Noch keine Änderungen protokolliert.</p><% } %></div>
  </section>
</div>
