<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Timely – Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Raleway:wght@400;600&display=swap" rel="stylesheet">
  <style>
    body{ background:#111216; color:#f7f5f0; font-family:'Raleway',sans-serif }
    .card{ background:#1b1d23; border-radius:1.25rem; box-shadow:0 20px 50px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.04); }
    .btn{ background:linear-gradient(180deg,#c5a268,#b48c4d); color:#1b1d23; }
    .btn:hover{ filter:brightness(1.05) }
  </style>
</head>
<body class="min-h-screen grid place-items-center p-4">
  <div class="w-full max-w-[380px] card p-6">
    <div class="flex items-center gap-3 mb-4">
      <img src="/img/logo.png" class="h-12 w-auto" alt="Logo">
      <div>
        <div class="text-2xl font-semibold" style="font-family:'Playfair Display',serif">Timely</div>
        <div class="text-xs text-white/60 -mt-0.5">Zeit erfasst. Einfach.</div>
      </div>
    </div>

    <h1 class="text-lg font-semibold mb-3"><%= adminLogin?'Verwaltung freischalten':pairAvailable?'Handy einmalig anmelden':'Anmelden' %></h1>
    <% if(adminLogin) { %><p class="text-sm text-white/70 mb-3">Für die Verwaltung bitte deine persönliche PIN bestätigen.</p><% } else if(pairAvailable) { %><p class="text-sm text-white/70 mb-3">Wähle deinen Namen und gib deine PIN ein. Danach erkennt Timely diesen Browser bei weiteren QR-Scans im Betriebs-WLAN.</p><% } %>
    <% if(flash) { %><p class="text-sm text-amber-200 mb-3"><%= flash %></p><% } %>
    <form method="post" action="/login" class="space-y-3">
      <%- include('_csrf') %>
      <input type="hidden" name="admin_login" value="<%= adminLogin?'1':'0' %>">
      <div>
        <label for="employee_id" class="block text-sm mb-1">Mitarbeiter</label>
        <select id="employee_id" name="employee_id" required
        class="employee-select w-full bg-transparent border border-white/15 rounded px-3 py-2">
    <option value="" disabled <%= selectedEmployeeId?'':'selected' %>>Bitte deinen Namen auswählen</option>
  <% employees.forEach(e => { %>
    <option value="<%= e.id %>" <%= selectedEmployeeId===String(e.id)?'selected':'' %>><%= e.name %></option>
  <% }) %>
</select>

      </div>
      <div>
        <label for="pin" class="block text-sm mb-1">PIN (4–6 Ziffern)</label>
        <input id="pin" name="pin" type="password" inputmode="numeric" pattern="[0-9]{4,6}" minlength="4" maxlength="6" autocomplete="current-password" class="w-full bg-transparent border border-white/15 rounded px-3 py-2" required/>
      </div>
      <% if(pairAvailable && !adminLogin) { %>
        <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="remember_device" checked class="mt-1"><span>Dieses persönliche Handy mit meinem Konto verknüpfen.<br><span class="text-xs text-white/60">Bei einem gemeinsam genutzten Gerät abwählen.</span></span></label>
        <label for="device_label" class="block text-sm">Name für dein Gerät (optional)</label>
        <input id="device_label" name="device_label" maxlength="80" placeholder="Zum Beispiel: Mein iPhone" class="w-full bg-transparent border border-white/15 rounded px-3 py-2">
      <% } %>
      <% if (error) { %><div class="text-red-400 text-sm"><%= error %></div><% } %>
      <button class="btn w-full rounded py-2 mt-1"><%= adminLogin?'Verwaltung öffnen':'Anmelden' %></button>
    </form>
  </div>
</body>
</html>
